---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { joinCopy } from '../data/lab';
---

<BaseLayout title="Join Us" description="Join the Meng Lab. Recruitment details will be added when available.">
  <section class="section">
    <div class="wrap">
      <SectionHeading title={joinCopy.heading} as="h1">
        <p class="lede mt-6">{joinCopy.interest}</p>
        <p class="lede mt-4">{joinCopy.recruitmentPending}</p>
      </SectionHeading>
    </div>
  </section>
</BaseLayout>
