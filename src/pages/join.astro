---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { joinCopy } from '../data/lab';
---

<BaseLayout title="Join Us" description="Join the Meng Lab. Recruitment details will be added when available.">
  <section class="section">
    <div class="wrap">
      <SectionHeading title={joinCopy.heading} as="h1">
        <p class="lede mt-6">{joinCopy.interest}</p>
        <p class="lede mt-4">{joinCopy.recruitmentPending}</p>
      </SectionHeading>
    </div>
  </section>

  <!-- PLACEHOLDER: recruitment and institutional details pending. Do not invent hiring information. -->
  <section class="section pt-0" aria-labelledby="research-environment">
    <div class="wrap measure">
      <h2 id="research-environment" class="section-title mb-5">Research Environment</h2>
      <p class="muted">{joinCopy.environment}</p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="postdocs">
    <div class="wrap measure">
      <h2 id="postdocs" class="section-title mb-5">Postdoctoral Fellows</h2>
      <p class="muted">{joinCopy.roles.postdoc}</p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="graduate-students">
    <div class="wrap measure">
      <h2 id="graduate-students" class="section-title mb-5">Graduate Students</h2>
      <p class="muted">{joinCopy.roles.graduate}</p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="research-staff">
    <div class="wrap measure">
      <h2 id="research-staff" class="section-title mb-5">Research Staff</h2>
      <p class="muted">{joinCopy.roles.staff}</p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="how-to-apply">
    <div class="wrap measure">
      <h2 id="how-to-apply" class="section-title mb-5">How to Apply</h2>
      <p class="muted">{joinCopy.apply}</p>
    </div>
  </section>
</BaseLayout>
