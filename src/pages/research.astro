---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchItem from '../components/ResearchItem.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { researchPage, researchThemes } from '../data/lab';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Research" description={researchPage.intro}>
  <section class="section">
    <div class="wrap">
      <SectionHeading title="Research" as="h1">
        <p class="lede mt-6">{researchPage.intro}</p>
      </SectionHeading>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="research-themes">
    <div class="wrap">
      <h2 id="research-themes" class="sr-only">Research themes</h2>
      {
        researchPage.sections.map((section, index) => {
          const image = 'image' in section ? section.image : undefined;
          const imageAlt = 'imageAlt' in section ? section.imageAlt : undefined;
          const showMedia = index === 1;

          return (
            <ResearchItem
              number={researchThemes[index].number}
              title={section.title}
              summary={section.text}
              split={showMedia}
            >
              {index === 0 && (
                <div slot="selected-work" class="selected-work">
                  <p class="eyebrow">Selected published work</p>
                  <h4 id="cm-yapon" class="selected-work__title">
                    {researchPage.cmYapon.title}
                  </h4>
                  <p>{researchPage.cmYapon.text}</p>
                </div>
              )}
              {showMedia &&
                (image ? (
                  <figure class="research-theme-media m-0">
                    <div class="research-theme-media__frame">
                      <img
                        src={withBase(image)}
                        alt={imageAlt ?? 'Research theme illustration'}
                        width="1122"
                        height="1402"
                        decoding="async"
                        loading="lazy"
                      />
                    </div>
                  </figure>
                ) : (
                  <ImagePlaceholder
                    aspect="4 / 5"
                    label="Image forthcoming"
                    alt="Placeholder for research theme imagery"
                  />
                ))}
            </ResearchItem>
          );
        })
      }

      <section class="research-approach" aria-labelledby="our-approach">
        <h2 id="our-approach" class="section-title mb-4">{researchPage.approach.title}</h2>
        <p class="lede m-0">{researchPage.approach.text}</p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .selected-work {
    margin-top: 1.5rem;
    max-width: var(--text-measure);
  }

  .selected-work .eyebrow {
    margin-bottom: 0.45rem;
  }

  .selected-work__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .selected-work p:last-child {
    color: var(--color-muted);
  }

  .research-approach {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
    max-width: var(--text-measure);
  }

  @media (min-width: 768px) {
    .research-approach {
      margin-top: 5.5rem;
      padding-top: 3.5rem;
    }
  }
</style>
