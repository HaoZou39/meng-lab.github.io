---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchItem from '../components/ResearchItem.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { researchPage, researchThemes } from '../data/lab';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Research" description="Published research from the Meng Lab.">
  <section class="section">
    <div class="wrap">
      <SectionHeading title="Research" as="h1">
        <p class="lede mt-6">{researchPage.intro}</p>
      </SectionHeading>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="research-themes">
    <div class="wrap">
      <h2 id="research-themes" class="sr-only">Published research themes</h2>
      {
        researchPage.sections.map((section, index) => {
          const image = 'image' in section ? section.image : undefined;
          const imageAlt = 'imageAlt' in section ? section.imageAlt : undefined;
          const showMedia = index === 1;

          return (
            <ResearchItem
              number={researchThemes[index].number}
              title={section.title}
              summary={section.text}
              split={showMedia}
            >
              {showMedia &&
                (image ? (
                  <figure class="research-theme-media m-0">
                    <div class="research-theme-media__frame">
                      <img
                        src={withBase(image)}
                        alt={imageAlt ?? 'Research theme illustration'}
                        width="1122"
                        height="1402"
                        decoding="async"
                        loading="lazy"
                      />
                    </div>
                  </figure>
                ) : (
                  <ImagePlaceholder
                    aspect="4 / 5"
                    label="Image forthcoming"
                    alt="Placeholder for research theme imagery"
                  />
                ))}
            </ResearchItem>
          );
        })
      }
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="cm-yapon">
    <div class="wrap">
      {/* PI REVIEW REQUIRED: wording/branding only. */}
      <div class="measure">
        <h2 id="cm-yapon" class="section-title mb-5">{researchPage.cmYapon.title}</h2>
        <p class="lede">{researchPage.cmYapon.text}</p>
      </div>
    </div>
  </section>
</BaseLayout>
