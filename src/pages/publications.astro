---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getPublications } from '../lib/content';

const publications = await getPublications();

const featured = publications.filter((entry) => entry.data.featured);
const nonFeatured = publications.filter((entry) => !entry.data.featured);
const years = [...new Set(nonFeatured.map((entry) => entry.data.year))];
const featuredHeading = featured.length === 1 ? 'Featured Publication' : 'Featured Publications';
---

<BaseLayout title="Publications" description="Publications from the Meng Lab.">
  <section class="section">
    <div class="wrap">
      <SectionHeading title="Publications" as="h1" />

      <section class="mt-12 md:mt-16" aria-labelledby="featured-publications">
        <h2 id="featured-publications" class="section-title mb-6">{featuredHeading}</h2>
        {
          featured.length === 0 ? (
            <p class="empty-note">Featured publications will be listed here.</p>
          ) : (
            featured.map((entry) => (
              <PublicationItem
                title={entry.data.title}
                authors={entry.data.authors}
                journal={entry.data.journal}
                year={entry.data.year}
                doi={entry.data.doi}
                pubmed={entry.data.pubmed}
                pdf={entry.data.pdf}
                provisional={entry.data.provisional}
              />
            ))
          )
        }
      </section>

      <section class="mt-20 md:mt-28" aria-labelledby="other-publications">
        <h2 id="other-publications" class="section-title mb-6">Other Publications</h2>
        {
          nonFeatured.length === 0 ? (
            <p class="empty-note">Publications will be listed here as they are added.</p>
          ) : (
            years.map((year) => (
              <div class="mt-10">
                <h3 class="eyebrow">{year}</h3>
                {nonFeatured
                  .filter((entry) => entry.data.year === year)
                  .map((entry) => (
                    <PublicationItem
                      title={entry.data.title}
                      authors={entry.data.authors}
                      journal={entry.data.journal}
                      year={entry.data.year}
                      doi={entry.data.doi}
                      pubmed={entry.data.pubmed}
                      pdf={entry.data.pdf}
                      provisional={entry.data.provisional}
                    />
                  ))}
              </div>
            ))
          )
        }
      </section>
    </div>
  </section>
</BaseLayout>
