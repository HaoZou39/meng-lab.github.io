---
import { lab } from '../data/lab';
import { withBase } from '../lib/paths';
import HeroMedia from './HeroMedia.astro';
---

<section class="section pt-12 md:pt-[4.5rem] lg:pt-20">
  <div class="wrap">
    <HeroMedia />
    <h1 class="hero-title mt-10 md:mt-14">{lab.taglineLines[0]}<br />{lab.taglineLines[1]}</h1>
    <p class="hero-identity mt-5">{lab.scientificIdentityLine}</p>
    <p class="lede mt-6">{lab.supportingSentence}</p>
    <p class="mt-8">
      <a class="editorial-link" href={withBase('/research')}>
        Explore our research <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .hero-identity {
    max-width: 42rem;
    color: var(--color-text);
    font-size: clamp(1rem, 0.25vw + 0.95rem, 1.125rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }
</style>
