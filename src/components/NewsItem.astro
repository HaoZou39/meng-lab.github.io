---
interface Props {
  title: string;
  date: Date;
  href?: string;
  placeholder?: boolean;
}

const { title, date, href, placeholder = false } = Astro.props;

const day = date.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'UTC' });
const month = date.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
const year = date.toLocaleDateString('en-GB', { year: 'numeric', timeZone: 'UTC' });
const formatted = `${day} ${month}, ${year}`;
---

<article class="news-row">
  <time class="meta" datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
  <div>
    {
      href ? (
        <a class="editorial-link" href={href}>
          {title}
        </a>
      ) : (
        <p>{title}</p>
      )
    }
    {placeholder && <p class="meta mt-1">Development placeholder — not laboratory news.</p>}
  </div>
</article>
